{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "file-transfer",
  "version": "0.1.0",
  "identifier": "com.teren.file-transfer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "File Transfer",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 460,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
